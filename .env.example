# Family Finances: copie para .env (desenvolvimento) ou para o ambiente do servidor/contêiner.

# ---- Servidor ----
PORT=3010
# 127.0.0.1 atrás de proxy reverso; 0.0.0.0 dentro de contêiner
HOST=127.0.0.1
# pasta do banco SQLite, arquivos enviados e backups (guarde fora do código e faça backup)
DATA_DIR=./data
APP_NAME=Family Finances
# proxy reverso na frente (nginx, Cloudflare Tunnel): "loopback" (padrão), um IP/sub-rede, um número de saltos ou false
TRUST_PROXY=loopback
# cookie de sessão com Secure: auto (quando a requisição chega por HTTPS), true ou false
COOKIE_SECURE=auto
SESSION_DAYS=30

# ---- Usuários ----
# Criados no início se ainda não existirem (nunca mudam a senha de quem já existe).
# Todo usuário criado assim troca a senha no primeiro acesso. Depois, crie outros em Ajustes > Usuários.
FF_ADMIN_USERNAME=admin
FF_ADMIN_NAME=Administrador
# vazio = senha gerada e gravada em $DATA_DIR/initial-passwords.txt (permissão 600)
FF_ADMIN_PASSWORD=

# Outras pessoas da casa: usuario:Nome, separados por vírgula
FF_USERS=
# Senha inicial opcional de cada um: FF_PASSWORD_<USUARIO> (sem ela, é gerada)
# FF_PASSWORD_ANA=

# ---- Classificação ----
# Cidades onde vocês compram no dia a dia: nome da cidade colado na compra de cartão indica compra presencial
FF_HOME_CITIES=

# ---- IA opcional (regras automáticas para lojas sem categoria) ----
# Desligada se vazio. Envia só o nome da loja (sem valores, datas, contas, CPF/CNPJ e sem PIX).
#   anthropic: API da Anthropic (SDK oficial). Modelo padrão claude-opus-5-5.
#   openai:    qualquer API compatível com OpenAI (OpenAI, Ollama local, LM Studio, OpenRouter...). Exige FF_AI_MODEL.
#   webhook:   seu próprio serviço: POST {categories, items} -> {items:[{key, category, confidence}]}
FF_AI_PROVIDER=
FF_AI_MODEL=
# anthropic: também aceita ANTHROPIC_API_KEY. webhook: enviado como "Authorization: Bearer ..."
FF_AI_API_KEY=
# openai: ex. http://127.0.0.1:11434/v1 (Ollama). webhook: URL do serviço
FF_AI_BASE_URL=
# valor inicial de "analisar automaticamente a cada arquivo enviado" (o admin muda em Ajustes)
FF_AI_AUTO=false
# confiança mínima (0 a 1) para criar a regra
FF_AI_MIN_CONFIDENCE=0.8
